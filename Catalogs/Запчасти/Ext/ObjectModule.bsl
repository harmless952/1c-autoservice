
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Запчасти.Наименование КАК Наименование
	|ИЗ 
	|	Справочник.Запчасти КАК Запчасти 
	|ГДЕ
	|	Запчасти.Артикул = &Артикул
	|	И Запчасти.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТекстОшибки = СтрШаблон("Артикул %1 уже используется у запчасти «%2»", Артикул, Выборка.Наименование);
		СообщитьОбОшибке(ТекстОшибки, Отказ);  	
	КонецЕсли;
	
КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстОшибки, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = "Артикул";
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить(); 
	
	Отказ = Истина;

КонецПроцедуры
