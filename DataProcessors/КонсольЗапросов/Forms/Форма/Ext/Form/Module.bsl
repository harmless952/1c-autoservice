&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
   
   ВыполнитьНаСервере();
   
КонецПроцедуры  

&НаСервере
Процедура ВыполнитьНаСервере()
	
	Результат.Очистить();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	// Шапка: имена колонок
	Для НомерКолонки = 1 По Таблица.Колонки.Количество() Цикл
		Колонка = Таблица.Колонки[НомерКолонки - 1];
		Результат.Область(СтрШаблон("R1C%1", НомерКолонки)).Текст = Колонка.Имя;
		Результат.Область(СтрШаблон("C%1", НомерКолонки)).ШиринаКолонки = 30;
	КонецЦикла;
	
	// Строки результата
	Для НомерСтроки = 1 По Таблица.Количество() Цикл
		СтрокаТаблицы = Таблица[НомерСтроки - 1];
		Для НомерКолонки = 1 По Таблица.Колонки.Количество() Цикл
			Значение = СтрокаТаблицы[НомерКолонки - 1];
			Результат.Область(СтрШаблон("R%1C%2", НомерСтроки + 1, НомерКолонки)).Текст = Строка(Значение);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры