Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиЗапчастей.Записывать = Истина;
	Движения.ВыработкаМастеров.Записывать = Истина;
	
	Если Статус <> Перечисления.СтатусыЗаказНарядов.Выполнен Тогда
		Возврат;
	КонецЕсли;
	
	СписатьЗапчасти(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОтразитьВыработку();
	
КонецПроцедуры

Процедура СписатьЗапчасти(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказНарядЗапчасти.Запчасть КАК Запчасть,
	|	СУММА(ЗаказНарядЗапчасти.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Запчасти
	|ИЗ
	|	Документ.ЗаказНаряд.Запчасти КАК ЗаказНарядЗапчасти
	|ГДЕ
	|	ЗаказНарядЗапчасти.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНарядЗапчасти.Запчасть
	|;
	|ВЫБРАТЬ
	|	ВТ_Запчасти.Запчасть КАК Запчасть,
	|	ВТ_Запчасти.Количество КАК Требуется,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ВНаличии,
	|	ЕСТЬNULL(Остатки.СуммаОстаток, 0) КАК СуммаОстаток
	|ИЗ
	|	ВТ_Запчасти КАК ВТ_Запчасти
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЗапчастей.Остатки(
	|				&Граница,
	|				Запчасть В (ВЫБРАТЬ ВТ.Запчасть ИЗ ВТ_Запчасти КАК ВТ)) КАК Остатки
	|		ПО ВТ_Запчасти.Запчасть = Остатки.Запчасть";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Требуется > Выборка.ВНаличии Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Недостаточно запчасти «%1»: требуется %2, в наличии %3",
				Выборка.Запчасть, Выборка.Требуется, Выборка.ВНаличии);
			Сообщение.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Требуется = Выборка.ВНаличии Тогда
			Себестоимость = Выборка.СуммаОстаток;
		Иначе
			Себестоимость = Выборка.СуммаОстаток / Выборка.ВНаличии * Выборка.Требуется;
		КонецЕсли;
		
		Движение = Движения.ОстаткиЗапчастей.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Запчасть = Выборка.Запчасть;
		Движение.Количество = Выборка.Требуется;
		Движение.Сумма = Себестоимость;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтразитьВыработку()
	
	Для Каждого Строка Из Работы Цикл
		Движение = Движения.ВыработкаМастеров.Добавить();
		Движение.Период = Дата;
		Движение.Мастер = Мастер;
		Движение.Работа = Строка.Работа;
		Движение.Нормочасы = Строка.Нормочасы;
		Движение.Сумма = Строка.Сумма;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	// Шаг 1. Если автомобиль не заполнен — проверять нечего, выходим
	Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
		Возврат;
	
	КонецЕсли;
	
	
	// Шаг 2. Запрос: последний выполненный заказ-наряд по этой машине 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗН.Пробег КАК Пробег,
	|	ЗН.Номер КАК Номер,
	|	ЗН.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗН
	|ГДЕ
	|	ЗН.Автомобиль = &Автомобиль
	|	И ЗН.Статус = &Выполнен
	|	И ЗН.Проведен
	|	И ЗН.Ссылка <> &Ссылка
	|	И ЗН.Дата < &Дата
	|УПОРЯДОЧИТЬ ПО
	|	ЗН.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("Выполнен", Перечисления.СтатусыЗаказНарядов.Выполнен);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	// Шаг 3. Если нашёлся и наш пробег меньше — сообщение и Отказ
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И Выборка.Пробег > Пробег Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Пробег %1 меньше, чем в заказ-наряде № %2 от %3 (%4 км)",
			Пробег, Выборка.Номер, Формат(Выборка.Дата, "ДЛФ=D"), Выборка.Пробег);
		Сообщение.Поле = "Пробег";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры
